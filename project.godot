; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="EpochsofError"
run/main_scene="uid://d2768suhwk81j"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="uid://c53iybf0qkf4w"

[autoload]

EvolutionManager="*res://scripts/EvolutionManager.gd"
AudioManager="*res://scripts/audio_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/health_bar_2d/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "red",
"res://resources/": "pink",
"res://scenes/": "teal",
"res://scripts/": "yellow"
}

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input]

pause_game={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[maaacks_credits_scene]

disable_plugin_dialogues=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
